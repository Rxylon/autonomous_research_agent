# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real key to this file — it is tracked
# by git. (An earlier version of this file did contain a live Gemini key; it has
# been removed and that key must be treated as compromised and rotated.)
#
# With no key set the app still runs end to end: retrieval, reporting, and the
# WebSocket stream all work, but summaries come from a local deterministic
# fallback and critic scores are keyword heuristics. GET /health tells you which
# mode you are in via `llm_configured`.
# ---------------------------------------------------------------------------

# One of: gemini, openai, mock
DEFAULT_LLM_PROVIDER=mock

# Model id for the chosen provider.
#   gemini -> gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
#   openai -> gpt-4o-mini, gpt-4o
DEFAULT_LLM_MODEL=gemini-2.0-flash

# Provide only the key for the provider you selected above.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding tier: auto | local | hash | openai
#   auto   - try the local model, fall back to hashing (default)
#   local  - local model only
#   hash   - no model at all; deterministic hashed bag-of-words. Use this on a
#            512 MB host, where loading torch plus a transformer will OOM.
#   openai - OpenAI embeddings; requires OPENAI_API_KEY
# Switching tiers starts a fresh Chroma collection, because vectors from
# different models are not comparable (and OpenAI's are a different width).
EMBEDDING_BACKEND=auto

# Local embedding model (Sentence-Transformers id). Note the `-en-`: the id
# without it does not exist on Hugging Face. First run downloads ~130 MB.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated list of allowed browser origins for HTTP requests.
CORS_ORIGINS=http://localhost:3000

# Storage. Relative paths resolve against the backend/ directory, not the
# process working directory.
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=research_documents
DATA_DIRECTORY=data
REPORTS_DIRECTORY=reports

# Tuning
MAX_DOCUMENTS_PER_QUERY=5
HTTP_TIMEOUT_SECONDS=8
