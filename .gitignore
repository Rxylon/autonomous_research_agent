# Virtual environments
.venv/
backend/.venv/
env/
venv/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Firebase deploy artifacts (generated by `firebase deploy`)
.firebase/
firebase-debug.log*
.vercel

# Backend runtime data — generated at run time, never committed
backend/data/
backend/reports/
backend/logs/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite3
.pytest_cache/
.coverage
htmlcov/

# Environment variables & API keys.
# `.env.example` is the tracked template and must never contain a real key.
.env
.env.*
!.env.example

# Logs
*.log

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.qodo/
